# PowerSignal Ingestion — environment variables
# Copy this file to `.env` and fill in actual values. Never commit `.env`.

# ─── data.go.kr 공공데이터포털 ─────────────────────────────────────────────
# 활용신청 → 발급된 서비스키. 인코딩된 값(URL-encoded)으로 그대로 사용.
# 각 데이터셋(D1/D2/D4)마다 별도 활용신청이 필요할 수 있음.
DATA_GO_KR_SERVICE_KEY=

# ─── 기상청 KMA ─────────────────────────────────────────────────────────
# data.kma.go.kr ASOS 시간자료. 공공데이터포털 키와 동일할 수도, 다를 수도 있음.
# 비어 있으면 DATA_GO_KR_SERVICE_KEY 로 폴백.
KMA_SERVICE_KEY=

# ─── 스토리지 ───────────────────────────────────────────────────────────
# SQLite (개발). 운영 전환 시 postgresql+psycopg://... 로 변경.
DATABASE_URL=sqlite:///./data/powersignal.db

# 원본 응답 보존 디렉터리. 일자별로 하위 폴더 자동 생성.
RAW_DATA_DIR=./data/raw
PARSED_DATA_DIR=./data/parsed
STATIC_DATA_DIR=./data/static

# ─── HTTP 클라이언트 ───────────────────────────────────────────────────
# 트래픽 제한 대응. 개발계정 기본 100건/일이므로 백필 시 주의.
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=5
HTTP_RATE_LIMIT_PER_SEC=2

# ─── 로깅 ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
